
{
  "definitions": [
    {
      "title": "Video",
      "id": "video",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Video",
              "model": "video"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "video",
      "fields": [

        {
          "component": "reference",
          "valueType": "string",
          "name": "assetPath",
          "label": "Video Asset (DAM)",
          "accept": ["video/mp4", "video/webm", "video/ogg"],
          "visibleWhen": { "sourceType": "dam" },
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "videoUrl",
          "label": "External Video URL",
          "placeholder": "https://www.youtube.com/watch?v=… | https://vimeo.com/… | Brightcove player URL",
          "visibleWhen": { "sourceType": "url" }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "posterPath",
          "label": "Thumbnail (Poster)",
          "accept": ["image/jpeg", "image/png", "image/webp"],
          "multi": false
        }
        
        
      ]
    }
  ],
  "filters": [
    {
      "rule": "atLeastOne",
      "fields": ["assetPath", "videoUrl"],
      "message": "Provide either a DAM Asset or an External Video URL."
    }
  ]
}
